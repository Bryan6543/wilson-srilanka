# Copy to .env.local for local development, or set these in your hosting dashboard.
# Never commit real values. Only NEXT_PUBLIC_* values are visible to browsers.

# --- Site -------------------------------------------------------------------
# Public URL of the site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.lk
# Optional display name (defaults to "Wilson Sri Lanka")
NEXT_PUBLIC_SITE_NAME=

# --- Database & storage (Supabase) — required for admin editing in production --
SUPABASE_URL=
# Server-only secret. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to "product-images" (created by the migration)
SUPABASE_STORAGE_BUCKET=

# --- Admin sign-in -------------------------------------------------------------
# Generate the hash and secret with:  npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Contact form email (optional, via Resend) ---------------------------------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Wilson Sri Lanka <web@example.lk>"
RESEND_FROM=
# Where contact messages are delivered (comma-separate multiple addresses)
CONTACT_TO=

# --- Local retailer --------------------------------------------------------------
LOCAL_RETAILER_NAME=United Sports
LOCAL_RETAILER_URL=https://www.unitedsports.lk
# Optional: adds utm_source=<value> to outbound "Buy" links
RETAILER_UTM_SOURCE=
# Retailer offers page and the name shown on offer badges
RETAILER_OFFERS_PAGE=/pages/anniversary-offers
RETAILER_OFFER_LABEL=Anniversary Offer

# --- Development only ----------------------------------------------------------
# Save admin changes to ./.data/ when Supabase is not configured. Ignored on Netlify/Vercel.
LOCAL_DATA_STORE=false
